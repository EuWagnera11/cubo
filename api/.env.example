# Cubo Studio Backend — env vars

# App
PORT=8000
ENV=production
LOG_LEVEL=info

# Database (gerenciado pelo docker-compose — POSTGRES_PASSWORD apenas)
# DATABASE_URL é setado automaticamente no docker-compose
POSTGRES_PASSWORD=mudar-isso-uma-senha-forte-aqui

# Redis (gerenciado pelo docker-compose)
# REDIS_URL é setado automaticamente

# Auth
JWT_SECRET=mudar-isso-em-prod-com-openssl-rand-hex-32
JWT_EXPIRE_MIN=10080

# Freepik (lista separada por vírgula)
FREEPIK_API_KEYS=FPSX_key1,FPSX_key2,FPSX_key3

# Storage (Cloudflare R2 ou AWS S3)
STORAGE_BUCKET=cubo-generations
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_PUBLIC_URL=https://r2.refinecubo.com.br

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — Planos mensais (Starter R$27 / Creator R$59 / Pro R$129 / Studio R$799)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...

# Stripe — Planos anuais (-30% + bônus boas-vindas)
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_CREATOR_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_STUDIO_YEARLY=price_...

# Stripe — Top-up packs (Boost 3k/8k/25k/80k)
STRIPE_PRICE_BOOST_3K=price_...
STRIPE_PRICE_BOOST_8K=price_...
STRIPE_PRICE_BOOST_25K=price_...
STRIPE_PRICE_BOOST_80K=price_...

# Stripe — Add-ons one-shot
STRIPE_PRICE_ADDON_KLING_V3_PRO_AUDIO=price_...
STRIPE_PRICE_ADDON_VEO_4K_AUDIO=price_...
STRIPE_PRICE_ADDON_MAGNIFIC_8K=price_...
STRIPE_PRICE_ADDON_LORA_MEDIUM=price_...
STRIPE_PRICE_ADDON_LORA_ULTRA=price_...
STRIPE_PRICE_ADDON_VOICE_CLONE=price_...

# Optional integrations
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...
SENTRY_DSN=https://...@sentry.io/...
RESEND_API_KEY=re_...

# CORS (frontend domains separados por vírgula)
CORS_ORIGINS=https://app.refinecubo.com.br,https://refinecubo.com.br,https://soph.ia.com.br
